RewriteEngine On

# Rule 1: Serve static files directly
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Rule 2: Routes with trailing slash -> .html
# /about/ -> /about.html
RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+)/$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^([a-zA-Z0-9_-]+)/$ /$1.html [L]

# Rule 3: Routes without trailing slash -> .html
# /about -> /about.html
RewriteCond %{REQUEST_URI} ^/([a-zA-Z0-9_-]+)$
RewriteCond %{DOCUMENT_ROOT}/%1.html -f
RewriteRule ^([a-zA-Z0-9_-]+)$ /$1.html [L]

# Rule 4: Homepage
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /index.html [L]

# Rule 5: Fallback to index.html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ /index.html [L]

# File types
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/webp .webp

# Allow all file access
<FilesMatch ".*">
  Require all granted
</FilesMatch>

# Disable directory browsing  
Options -Indexes

# Cache control
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp|woff|woff2)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>

<FilesMatch "\.(html)$">
  Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>
