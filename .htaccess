<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve files from out/ directory
  RewriteCond %{REQUEST_URI} !^/out/
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f [OR]
  RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -d
  RewriteRule ^(.*)$ /out/$1 [L]

  # If still not found, try index.html from out/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.*)$ /out/index.html [L]
</IfModule>

# MIME Types
AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/webp .webp

# Disable directory listing
Options -Indexes

# Cache control
<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp)$">
  Header set Cache-Control "max-age=31536000, public"
</FilesMatch>
