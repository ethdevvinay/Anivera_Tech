RewriteEngine On
RewriteBase /

# Handle Next.js Image Optimization API

RewriteCond %{REQUEST_URI} ^/\_next/image
RewriteCond %{QUERY_STRING} url=([^&]+)
RewriteRule ^.\*$ /out%1? [L,R=301]

# Serve static files from out/

RewriteCond %{REQUEST_URI} !^/out/
RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI} -f
RewriteRule ^(.\*)$ /out/$1 [L]

# Handle /about/ -> /out/about.html (with trailing slash)

RewriteCond %{REQUEST_URI} ^/([^/]+)/$
RewriteCond %{DOCUMENT_ROOT}/out/%1.html -f
RewriteRule ^([^/]+)/$ /out/$1.html [L]

# Handle /about -> /out/about.html (without trailing slash)

RewriteCond %{REQUEST_URI} !^/out/
RewriteCond %{REQUEST_URI} !\.(html|css|js|png|jpg|jpeg|gif|ico|svg|webp|txt|xml|pdf)$
RewriteCond %{DOCUMENT_ROOT}/out%{REQUEST_URI}.html -f
RewriteRule ^(.*)$ /out/$1.html [L]

# Fallback to index.html

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/out/
RewriteRule ^(.\*)$ /out/index.html [L]

# MIME Types

AddType application/javascript .js
AddType text/css .css
AddType image/svg+xml .svg
AddType image/png .png
AddType image/jpeg .jpg .jpeg
AddType image/webp .webp

# Allow access to all files

<FilesMatch ".\*">
Require all granted
</FilesMatch>

Options -Indexes +FollowSymLinks

# Cache

<FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|webp)$">
Header set Cache-Control "max-age=31536000, public"
</FilesMatch>
